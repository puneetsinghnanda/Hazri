<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminders. POST_NOTIFICATIONS is requested at setup step 3; denying it
         never blocks setup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On-time reminders. USE_EXACT_ALARM is deliberately NOT declared: it is
         reserved for alarm and calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Background paath: the media session runs as a foreground service so
         the recitation keeps going when the phone is locked (PRD 1.8). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- The Simran timer holds the screen on while it is visible. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Phase 2 needs the network for the sangat, diary sync and analytics
         (CLAUDE.md rule 4). Nothing a person reads needs it: every bani, its
         recitation, the calendar and the diary are on this phone and work
         with the radio off. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No advertising ID, ever (PRD §13). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:enableOnBackInvokedCallback="true">
        <!-- singleTask, and no empty taskAffinity.
             Both matter for a tapped link, and the pair of them is why
             tapping one produced four Hazris in the recents switcher.

             An empty android:taskAffinity means the activity belongs to no
             task at all, so every launch from another app with
             FLAG_ACTIVITY_NEW_TASK, which is how Gmail opens a link, starts
             a fresh task. singleTop only ever dedupes within one task, so it
             never applied: each tap built another instance, and the instance
             holding the reader's state was never the one handed the link.

             singleTask keeps one instance for the whole system. A link
             tapped while the app is running brings that instance forward
             and arrives through onNewIntent, which Flutter passes to the
             router. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Without this Flutter never hands an incoming link to the
                 router, so the App Link below would open the app on its
                 usual first screen and drop the link it was opened for. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
            <!-- Deep links from reminder notifications, e.g.
                 hazri://reader/japji-sahib?autoplay=1 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hazri" />
            </intent-filter>

            <!-- Android App Links: what lets a verification link be tapped
                 rather than copied out of a browser's address bar.

                 autoVerify makes Android fetch
                 https://<host>/.well-known/assetlinks.json at install time
                 and check it names this package and the certificate the
                 installed APK was signed with. All three have to agree, and
                 any disagreement fails in silence: the link opens a browser,
                 exactly as it did before, with nothing said anywhere.

                 Both hosts, because they are one Firebase Hosting site under
                 two names and a Firebase sign-in link has arrived on each of
                 them at different times. One deploy serves assetlinks.json
                 on both.

                 No path restriction on purpose. Firebase moved its sign-in
                 links off Dynamic Links onto a Hosting domain in August 2025
                 and the path changed with it, so anything keyed to a path is
                 a thing that breaks quietly the next time. IncomingLink
                 reads the URL and decides; a link that is neither a sign-in
                 nor an invite simply opens the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hazri-dfcc1.web.app" />
                <data android:scheme="https" android:host="hazri-dfcc1.firebaseapp.com" />
            </intent-filter>
        </activity>

        <!-- The media session. audio_service owns the notification, the lock
             screen controls and the Bluetooth/headset buttons. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- THE receiver that posts a scheduled reminder when its alarm fires.
             flutter_local_notifications declares no receivers of its own; its
             manifest carries permissions and nothing else, so without this
             line the alarm goes off, the broadcast finds no component, and
             nothing is ever shown. zonedSchedule does not throw and the
             notification sits in pendingNotificationRequests() looking
             perfectly scheduled, which is why four rounds of fixes to the
             scheduling code changed nothing at all. Do not remove it: nothing
             in Dart can see that it is gone. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- Runs a notification button pressed while the app is closed: the
             Snooze on a goal reminder. The plugin README asks for it. -->
        <!-- Hazri's own reminders (02-notifications DP7): the alarm, the
             buttons that do not open the app, and setting every alarm again
             after a reboot, an update or a clock change. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Diagnostics (02-notifications DP6): an alarm set without the
             plugin, to tell a phone that drops alarms from a plugin fault. -->
        <receiver
            android:name=".AlarmProbeReceiver"
            android:exported="false" />

        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- A Sangat push that arrives in the background is shown by Android
             itself, with these: the status-bar icon (the launcher icon is
             adaptive and not a valid small icon everywhere) and the Sangat
             channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sangat_v2" />

        <!-- Re-schedules the rolling reminder window after a reboot, a clock
             change or a time-zone change. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The Hukamnama share card goes out through the system share sheet. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/png" />
        </intent>
    </queries>
</manifest>
