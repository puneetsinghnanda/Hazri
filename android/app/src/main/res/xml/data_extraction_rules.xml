<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules (PRD 1.9).

  The diary, goals, reminders and settings are backed up to the user's own
  Google account. The bundled content database is not: it ships with the app
  and is rebuilt on install, so backing it up would only waste the user's quota.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="database" path="user.db-shm" />
        <include domain="file" path="user.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="content.db" />
        <exclude domain="file" path="content.version" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user.db" />
        <include domain="file" path="user.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="content.db" />
        <exclude domain="file" path="content.version" />
    </device-transfer>
</data-extraction-rules>
