<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules (PRD 1.9).

  These lists are a whitelist: anything not included is not backed up, so no
  <exclude> entries are needed.

  path_provider puts getApplicationDocumentsDirectory() at
  <data>/app_flutter (the "root" domain) and getApplicationSupportDirectory()
  at <data>/files (the "file" domain). user.db lives in the former and is
  backed up with the user's settings; the bundled content database lives in the
  latter and is left out, because it ships with the app and is rewritten on
  install.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
