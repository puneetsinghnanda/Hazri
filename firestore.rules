rules_version = '2';

// Hazri — Firestore security rules (ARCHITECTURE §5.11, 01-accounts §10.1).
//
// No client touches Firestore. Every read and write goes through the `api`
// Cloud Function with the Admin SDK, which these rules do not apply to; the
// scheduled and triggered Functions likewise. So the rules deny everything,
// to everybody, on every path.
//
// PUBLISHING. This file does nothing until it is deployed:
//   firebase deploy --only firestore
// (or pasted into the console, Firestore Database -> Rules -> Publish). The
// text in the console, not this text, is what is enforced.
//
// Publishing it turns off every direct read and write the older app build
// makes (users/{uid}, the old groups, presence, content/vichar), so it goes
// live together with the app build that talks to the api Function instead
// (PRD §11.4 step 4).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
