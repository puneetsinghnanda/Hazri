{
  "_note": "Design tokens for Ang Sang Phase 1. Map to a Flutter ThemeExtension (AngSangColors) + TextTheme. Values copied from the UX design files.",
  "color": {
    "light": {
      "bg": "#F4F3F8",
      "card": "#FFFFFF",
      "card2": "#ECEBF3",
      "ink": "#1B1D3A",
      "ink2": "#4D5070",
      "muted": "#85879F",
      "rule": "#E1E1EA",
      "primary": "#262C63",
      "onPrimary": "#FFFFFF",
      "kesri": "#D9730D",
      "kesriSoft": "#FBE8D2",
      "kesriInk": "#9A4F00",
      "sage": "#2E7A57",
      "sageSoft": "#DCEFE5",
      "teal": "#1F7A8C",
      "hl": "#FBE5CB",
      "word": "#A04F00",
      "simranField": "#080B1C",
      "simranThread": "#E8F4F8",
      "shadow": "0 1px 2px rgba(27,29,58,.06),0 10px 28px rgba(27,29,58,.07)",
      "scrim": "rgba(20,22,45,.45)"
    },
    "dark": {
      "bg": "#0C0F24",
      "card": "#161A37",
      "card2": "#1F2447",
      "ink": "#EDECF6",
      "ink2": "#B9BAD3",
      "muted": "#8084A6",
      "rule": "#2A2F55",
      "primary": "#F2A24E",
      "onPrimary": "#1C1206",
      "kesri": "#F2A24E",
      "kesriSoft": "#3A2A1A",
      "kesriInk": "#FFC27E",
      "sage": "#6CCB9C",
      "sageSoft": "#173327",
      "teal": "#6FC3D3",
      "hl": "rgba(242,162,78,.17)",
      "word": "#FFC27E",
      "simranField": "#080B1C",
      "simranThread": "#E8F4F8",
      "shadow": "0 0 0 1px rgba(255,255,255,.04)"
    }
  },
  "colorRoles": {
    "bg": "screen background",
    "card": "card surface",
    "card2": "secondary surface / chips",
    "ink": "primary text",
    "ink2": "secondary text",
    "muted": "tertiary text, inactive icons",
    "rule": "dividers",
    "primary": "primary buttons, brand (Neela navy in light, Kesri in dark)",
    "onPrimary": "text on primary",
    "kesri": "accent (saffron)",
    "kesriSoft": "accent container",
    "kesriInk": "text/icon on accent container",
    "sage": "success / done",
    "sageSoft": "success container",
    "teal": "info",
    "hl": "current-line highlight in reader",
    "word": "current-word underline/text in reader",
    "scrim": "bottom-sheet scrim"
  },
  "font": {
    "ui": {
      "family": "Mukta",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "use": "all UI text (Latin + Devanagari UI)"
    },
    "display": {
      "family": "Baloo Paaji 2",
      "weights": [
        500,
        600,
        700
      ],
      "use": "headlines, big numbers, Gurmukhi UI headings"
    },
    "gurbaniGurmukhi": {
      "family": "Noto Serif Gurmukhi",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "use": "Gurbani text in Gurmukhi"
    },
    "gurbaniDevanagari": {
      "family": "Noto Serif Devanagari",
      "weights": [
        400,
        500,
        600
      ],
      "use": "Gurbani text in Devanagari"
    },
    "_licence": "All four are SIL Open Font License — bundle the .ttf files in assets/fonts; never download fonts at runtime."
  },
  "type": {
    "body": {
      "size": 15,
      "lineHeight": 1.45
    },
    "eyebrow": {
      "size": 12,
      "letterSpacing": 0.08,
      "weight": 600,
      "case": "upper"
    },
    "button": {
      "size": 16,
      "weight": 600
    },
    "chip": {
      "size": 13,
      "weight": 600
    },
    "navLabel": {
      "size": 12
    },
    "readerGurmukhi": {
      "sizeDefault": 22,
      "range": [
        16,
        40
      ],
      "lineHeight": 1.7
    },
    "readerElder": {
      "sizeMin": 30
    },
    "readerDevanagari": {
      "sizeDefault": 21
    },
    "readerRoman": {
      "sizeDefault": 18
    }
  },
  "radius": {
    "card": 20,
    "button": 16,
    "chip": 999,
    "navPill": 16,
    "iconButton": 12,
    "sheet": 28
  },
  "size": {
    "designFrame": [
      390,
      844
    ],
    "buttonMinHeight": 52,
    "elderButtonMinHeight": 72,
    "navPill": [
      58,
      32
    ],
    "minTouchTarget": 48
  },
  "shadow": {
    "light": "0 1px 2px rgba(27,29,58,.06), 0 10px 28px rgba(27,29,58,.07)",
    "dark": "0 0 0 1px rgba(255,255,255,.04)"
  },
  "icons": {
    "style": "24px outline, stroke 1.8, round caps/joins",
    "source": "SVG paths in design/html (inline). Recreate as an icon font or SVG assets; Material Symbols Rounded is an acceptable fallback for generic icons."
  }
}
